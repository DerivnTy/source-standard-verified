{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "source-standard-mcp",
      "version": "0.1.0",
      "title": "Source Standard"
    },
    "tools": [
      {
        "name": "search_vendors",
        "title": "Search verified vendors",
        "description": "Search the Source Standard public vendor registry. Filter by US state, verification status, clinical focus, or free-text query on vendor name/city.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Case-insensitive substring matched against vendor name, city, and medical director."
            },
            "state": {
              "type": "string",
              "description": "Two-letter US state code (e.g. 'FL', 'TX')."
            },
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "unverified",
                "under-review",
                "suspended",
                "removed"
              ],
              "description": "Public verification status."
            },
            "focus": {
              "type": "string",
              "description": "Clinical focus keyword (e.g. 'TRT', 'Peptides', 'Weight Loss')."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max results to return. Defaults to 25, max 100."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_vendor",
        "title": "Get vendor profile",
        "description": "Return the full public profile for a Source Standard vendor by slug, including status, verification detail, clinical focus, and profile URL.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Vendor slug (from search_vendors results or the URL /directory/<slug>)."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_facilities",
        "title": "Search compounding facilities (Greenlist)",
        "description": "Search the Source Standard Greenlist of FDA-registered 503A/503B compounding pharmacies and outsourcing facilities. Filter by category, state, or free-text query.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Substring matched against facility name, focus, and location."
            },
            "category": {
              "type": "string",
              "enum": [
                "503B",
                "503A",
                "Other"
              ],
              "description": "Facility category."
            },
            "state": {
              "type": "string",
              "description": "Two-letter US state code."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max results. Defaults to 25."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_facility",
        "title": "Get facility record",
        "description": "Return the full Greenlist record for a compounding facility by slug, including FDA registration detail, inspection history, and any active regulatory alert.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Facility slug from search_facilities or /greenlist/<slug>."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_learn_content",
        "title": "List Learn content",
        "description": "List Source Standard educational content: guide topics, individual education articles, news articles, and FAQ pillar pages. Use this to discover what educational material is available before calling get_learn_article.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "all",
                "education",
                "news",
                "faq",
                "topics"
              ],
              "description": "Filter which content to list. Defaults to 'all'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_learn_article",
        "title": "Get Learn article",
        "description": "Return the full body of a Source Standard Learn article (education or news) by slug. Use list_learn_content first to discover slugs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "education",
                "news"
              ],
              "description": "Which content stream the slug belongs to."
            },
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Article slug."
            }
          },
          "required": [
            "kind",
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
